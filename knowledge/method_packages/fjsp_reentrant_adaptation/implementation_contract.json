{
  "schema_version": 1,
  "contract_id": "fjsp_reentrant_adaptation",
  "mode": "complete_method_package",
  "fallback_improvement_order": [
    "reentrant_search_pressure"
  ],
  "required_components": [
    {
      "component_id": "reentrant_tail_parser",
      "required_behaviors": [
        "在标准主体后精确消费 `job_count` 组三元组，并拒绝任何缺失或尾随 token。",
        "依据原始路线校验每个作业内局部循环边界和重复次数。"
      ]
    },
    {
      "component_id": "expanded_route_identity",
      "required_behaviors": [
        "在搜索前，将每条路线展开为 pre 加上重复 `repeat` 次的 loop_body，再加上 post。",
        "为展开后的工序分配连续的 op_id，并在每次经过中保留独立的机器选择。"
      ]
    },
    {
      "component_id": "expanded_complete_decoder",
      "required_behaviors": [
        "在作业优先约束和机器容量约束下构建并完整解码每一道展开后的工序。",
        "在评分前拒绝部分覆盖、重复、仅包含原始路线或依赖过期缓存的排程。"
      ]
    },
    {
      "component_id": "reentrant_search_pressure",
      "required_behaviors": [
        "在构造或搜索中至少使用一种有界的、能感知重复经过的搜索压力。",
        "保留互补的通用 FJSP 规则，并完成固定 evaluator 的完整校验。"
      ]
    }
  ],
  "coupled_groups": [
    {
      "group_id": "reentrant_route_semantics",
      "component_ids": [
        "reentrant_tail_parser",
        "expanded_route_identity",
        "expanded_complete_decoder",
        "reentrant_search_pressure"
      ],
      "rule": "解析、展开后的标识、解码、搜索与输出覆盖必须描述同一条展开后的路线。"
    }
  ],
  "forbidden_shortcuts": [
    "ignore_reentrant_tail",
    "schedule_only_original_operations",
    "reuse_source_op_id_across_passes",
    "force_all_passes_to_one_machine",
    "invent_uncontracted_rework_or_batch_constraints",
    "modify_evaluator"
  ]
}
