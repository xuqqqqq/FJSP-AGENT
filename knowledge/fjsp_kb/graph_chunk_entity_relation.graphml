  <data key="d2">与N. Krasnogor共同发表了关于有效模因算法的教程文章的研究人员。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-024</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="W. L. Strong">
  <data key="d0">W. L. Strong</data>
  <data key="d1">person</data>
  <data key="d2">发表了关于Shannon-Wiener指数值中偏向丰富度与均匀度关系的学术论文的研究人员。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-024</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="S. Yang">
  <data key="d0">S. Yang</data>
  <data key="d1">person</data>
  <data key="d2">与H. Huang等人共同发表了关于基于分解的多目标进化算法局部多样性评价分配策略的学术论文的研究人员。&lt;SEP&gt;论文“Local-diversity evaluation assignment strategy for decomposition-based multiobjective evolutionary algorithm”的作者之一。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-024&lt;SEP&gt;doc-f0490d27025df4a1e3094e5246569dcc-chunk-026</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;Self-Adaptive_Differential_Evolution-Enhanced_Quality-Diversity_Optimization_for_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation-1158bd89.pdf</data>
  <data key="d5">1785835930</data>
  <data key="d6"></data>
</node>
<node id="局部强化方案">
  <data key="d0">局部强化方案</data>
  <data key="d1">method</data>
  <data key="d2">局部强化方案是FLMA中的一种策略，用于增强局部搜索能力，提高解的质量。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="历史记忆">
  <data key="d0">历史记忆</data>
  <data key="d1">concept</data>
  <data key="d2">历史记忆是FLMA中用于存储过往搜索信息的组件，A2变体移除后采用随机选择替代。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="算子">
  <data key="d0">算子</data>
  <data key="d1">method</data>
  <data key="d2">算子是FLMA中用于搜索解的多种操作，A2变体中采用随机选择策略。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="第三类实例">
  <data key="d0">第三类实例</data>
  <data key="d1">data</data>
  <data key="d2">第三类实例是用于测试的基准数据集，具有不同的规模参数(F、n、m)，如表IV所示。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="表IV">
  <data key="d0">表IV</data>
  <data key="d1">content</data>
  <data key="d2">表IV呈现了在不同实例规模下FLMA及其变体的平均HV和IGD值。&lt;SEP&gt;展示KTCE与三个变体算法在第二个性能指标上的比较结果的表格，包含平均值和p值。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015&lt;SEP&gt;doc-78fb975a62b0ae0a55602842d9892197-chunk-011</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;Knowledge_Transfer-Based_Co-Evolutionary_Search_for_Energy-Saving_Distributed_Heterogeneous_Flexible_Job_Shop_Scheduling-6c8dcb66.pdf</data>
  <data key="d5">1785845168</data>
  <data key="d6"></data>
</node>
<node id="成对比较">
  <data key="d0">成对比较</data>
  <data key="d1">method</data>
  <data key="d2">成对比较是一种统计方法，用于在95%置信水平下比较FLMA与各变体的性能差异。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="EDFJSP-T约束">
  <data key="d0">EDFJSP-T约束</data>
  <data key="d1">concept</data>
  <data key="d2">EDFJSP-T是FLMA算法所针对的约束类型，代表一种具有时间约束的分布式柔性作业车间调度问题变体。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-015</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="Makespan (C_max)">
  <data key="d0">Makespan (C_max)</data>
  <data key="d1">concept</data>
  <data key="d2">最大完工时间，作业最后一道工序的完成时间加上可能的运输时间，是调度性能指标之一。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="TEC (Total Energy Consumption)">
  <data key="d0">TEC (Total Energy Consumption)</data>
  <data key="d1">data</data>
  <data key="d2">生产过程中的总能耗，由机器能耗和AGV能耗求和得到。&lt;SEP&gt;总能耗，车间生产过程中的能源消耗总量，作为节能调度的优化目标之一。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005&lt;SEP&gt;doc-14134317afd8f7893989aea5ef545cb8-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;A_Hybrid_Metaheuristic_Algorithm_for_Multiobjective_Scheduling_in_Distributed_Heterogeneous_Flexible_Job_Shops-82203ead.pdf</data>
  <data key="d5">1785842022</data>
  <data key="d6"></data>
</node>
<node id="机器能耗(E_mac)">
  <data key="d0">机器能耗(E_mac)</data>
  <data key="d1">concept</data>
  <data key="d2">所有机器的总能耗，包括待机能耗(空闲时段功耗)和加工能耗。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="AGV能耗(E_agv)">
  <data key="d0">AGV能耗(E_agv)</data>
  <data key="d1">concept</data>
  <data key="d2">所有自动导引小车的总能耗，包括待机能耗和运输过程中的能耗。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="Memetic算法(MA)">
  <data key="d0">Memetic算法(MA)</data>
  <data key="d1">method</data>
  <data key="d2">一种融合全局搜索和局部学习的进化算法，对复杂大规模问题具有强大的优化能力。&lt;SEP&gt;针对带作业优先级的柔性作业车间调度问题的优化算法</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005&lt;SEP&gt;doc-a38007468276a270c1727d6c565d8aa3-chunk-006</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;A memetic algorithm for the flexible job shop scheduling problem with job priority-f303156f.pdf</data>
  <data key="d5">1785848303</data>
  <data key="d6"></data>
</node>
<node id="机器(Machine)">
  <data key="d0">机器(Machine)</data>
  <data key="d1">artifact</data>
  <data key="d2">加工设备，每台机器在同一时刻只能加工一个作业的一道工序。&lt;SEP&gt;用于执行加工操作的设备。&lt;SEP&gt;位于工厂中的加工设备，一次只能加工一道工序。&lt;SEP&gt;用于执行加工操作的物理设备，在调度中具有可选性和处理时间。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005&lt;SEP&gt;doc-e5d47f23ff2115fdf069ba128946a7e2-chunk-025&lt;SEP&gt;doc-78fb975a62b0ae0a55602842d9892197-chunk-003&lt;SEP&gt;doc-a38007468276a270c1727d6c565d8aa3-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;An efficient memetic algorithm for distributed flexible job shop scheduling problem with transfers-316215e1.pdf&lt;SEP&gt;Knowledge_Transfer-Based_Co-Evolutionary_Search_for_Energy-Saving_Distributed_Heterogeneous_Flexible_Job_Shop_Scheduling-6c8dcb66.pdf&lt;SEP&gt;A memetic algorithm for the flexible job shop scheduling problem with job priority-f303156f.pdf</data>
  <data key="d5">1785848303</data>
  <data key="d6"></data>
</node>
<node id="AGV (Automated Guided Vehicle)">
  <data key="d0">AGV (Automated Guided Vehicle)</data>
  <data key="d1">artifact</data>
  <data key="d2">自动导引运输车，用于在机器间运输工件，同一时刻每辆AGV只能运输一个工件。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="作业(Job)">
  <data key="d0">作业(Job)</data>
  <data key="d1">concept</data>
  <data key="d2">待加工的工件，每个作业包含多道需要按顺序加工的工序。&lt;SEP&gt;在DFJSPT中，一个作业包含多个操作，可以在不同工厂间转移处理。&lt;SEP&gt;调度问题中需要完成的加工任务，由多道工序组成，且必须分配到某一工厂加工。&lt;SEP&gt;在调度中需要完成的生产任务，由多个操作按顺序组成。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005&lt;SEP&gt;doc-e5d47f23ff2115fdf069ba128946a7e2-chunk-025&lt;SEP&gt;doc-78fb975a62b0ae0a55602842d9892197-chunk-003&lt;SEP&gt;doc-a38007468276a270c1727d6c565d8aa3-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;An efficient memetic algorithm for distributed flexible job shop scheduling problem with transfers-316215e1.pdf&lt;SEP&gt;Knowledge_Transfer-Based_Co-Evolutionary_Search_for_Energy-Saving_Distributed_Heterogeneous_Flexible_Job_Shop_Scheduling-6c8dcb66.pdf&lt;SEP&gt;A memetic algorithm for the flexible job shop scheduling problem with job priority-f303156f.pdf</data>
  <data key="d5">1785848303</data>
  <data key="d6"></data>
</node>
<node id="操作(Operation)">
  <data key="d0">操作(Operation)</data>
  <data key="d1">concept</data>
  <data key="d2">作业的一道加工工序，需要被分配到机器上加工并由AGV运输。&lt;SEP&gt;作业的加工步骤，可以分配给不同工厂的合适机器执行。&lt;SEP&gt;作业中的一个加工步骤，需要在特定机器上完成，具有处理时间。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005&lt;SEP&gt;doc-e5d47f23ff2115fdf069ba128946a7e2-chunk-025&lt;SEP&gt;doc-a38007468276a270c1727d6c565d8aa3-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf&lt;SEP&gt;An efficient memetic algorithm for distributed flexible job shop scheduling problem with transfers-316215e1.pdf&lt;SEP&gt;A memetic algorithm for the flexible job shop scheduling problem with job priority-f303156f.pdf</data>
  <data key="d5">1785848303</data>
  <data key="d6"></data>
</node>
<node id="二进制决策变量(x, y, z)">
  <data key="d0">二进制决策变量(x, y, z)</data>
  <data key="d1">data</data>
  <data key="d2">取值为0或1的变量，x表示工序分配给机器，y表示机器间的转移，z表示AGV分配。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="连续决策变量(C, MC, AC)">
  <data key="d0">连续决策变量(C, MC, AC)</data>
  <data key="d1">data</data>
  <data key="d2">正实数变量，C表示工序完工时间，MC表示机器完工时间，AC表示AGV完工时间。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="精确算法(Exact Algorithm)">
  <data key="d0">精确算法(Exact Algorithm)</data>
  <data key="d1">method</data>
  <data key="d2">基于数学模型的精确求解方法，面对大规模问题求解时间过长，无法适应。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="启发式算法(Heuristic)">
  <data key="d0">启发式算法(Heuristic)</data>
  <data key="d1">method</data>
  <data key="d2">基于规则的近似求解方法，难以获得满意解。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="数学模型(Mathematical Model)">
  <data key="d0">数学模型(Mathematical Model)</data>
  <data key="d1">concept</data>
  <data key="d2">用于描述EDFJSP-T的数学模型，由目标函数(1)和约束(2)-(26)组成，包含决策变量和参数。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="目标函数(Objective Function)">
  <data key="d0">目标函数(Objective Function)</data>
  <data key="d1">concept</data>
  <data key="d2">极小化最大完工时间和总能耗的目标表达式(1)。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="约束(Constraints)">
  <data key="d0">约束(Constraints)</data>
  <data key="d1">concept</data>
  <data key="d2">限制决策变量取值以保证调度可行性的等式和不等式条件，如每台机器同时只能加工一个工件、每道工序必须分配机器等。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="加工时间(Processing Time)">
  <data key="d0">加工时间(Processing Time)</data>
  <data key="d1">concept</data>
  <data key="d2">工件在机器上的实际加工耗时，由p_{j,i,k}表示，是决定工序完工时间的关键参数。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="运输时间(Transportation Time)">
  <data key="d0">运输时间(Transportation Time)</data>
  <data key="d1">concept</data>
  <data key="d2">AGV将工件从一台机器运输到另一台机器所需的时间，由d_{k,k'}/v_a计算，影响工序完工时间。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-005</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
  <data key="d6"></data>
</node>
<node id="Jingjing Wang">
  <data key="d0">Jingjing Wang</data>
  <data key="d1">person</data>
  <data key="d2">该论文的作者之一，任职于北京工业大学。&lt;SEP&gt;北京工业大学信息技术学院助理教授，研究兴趣包括分布式与绿色车间调度、进化计算和强化学习。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-000&lt;SEP&gt;doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-025</data>
