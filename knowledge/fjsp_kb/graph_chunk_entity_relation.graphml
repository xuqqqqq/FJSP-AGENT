  <data key="d3">doc-2b3dfd7b5cbfa2a90ef71347e70c15cc-chunk-005</data>
  <data key="d4">An Artificial Bee Colony Algorithm for Coordinated Scheduling of Production Jobs and Flexible Maintenance in Permutation Flowshops-1bbea6e8.pdf</data>
