  <data key="d5">1785843068</data>
  <data key="d6"></data>
</node>
<node id="An Efficient Memetic Algorithm for Distributed Flexible Job Shop Scheduling Problem with Transfers">
  <data key="d0">An Efficient Memetic Algorithm for Distributed Flexible Job Shop Scheduling Problem with Transfers</data>
  <data key="d1">content</data>
  <data key="d2">提出一种高效的模因算法，用于带转移的分布式柔性作业车间调度问题。</data>
  <data key="d3">doc-f0490d27025df4a1e3094e5246569dcc-chunk-024</data>
