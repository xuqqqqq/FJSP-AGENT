  <data key="d1">method</data>
  <data key="d2">一种根据种群反馈动态调整搜索策略的自适应机制</data>
  <data key="d3">doc-f0490d27025df4a1e3094e5246569dcc-chunk-001</data>
  <data key="d4">Self-Adaptive_Differential_Evolution-Enhanced_Quality-Diversity_Optimization_for_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation-1158bd89.pdf</data>
  <data key="d5">1785835931</data>
  <data key="d6"></data>
</node>
