  <data key="d0">MATLAB R2017a</data>
  <data key="d1">artifact</data>
  <data key="d2">用于执行HDVMA的数学计算软件版本。</data>
  <data key="d3">doc-e630becb450dcca79375a56384053225-chunk-008</data>
  <data key="d4">Hybrid Memetic Algorithm to Solve Multiobjective Distributed Fuzzy Flexible Job Shop Scheduling Problem with Transfer-71a8369b.pdf</data>
