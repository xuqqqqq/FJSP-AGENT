  <data key="d6"></data>
</node>
<node id="能源效率">
  <data key="d0">能源效率</data>
  <data key="d1">concept</data>
  <data key="d2">在完成生产或计算任务的同时最小化能源消耗的概念。</data>
  <data key="d3">doc-78fb975a62b0ae0a55602842d9892197-chunk-037</data>
