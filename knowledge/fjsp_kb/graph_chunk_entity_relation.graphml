  <data key="d3">doc-e630becb450dcca79375a56384053225-chunk-016&lt;SEP&gt;doc-a38007468276a270c1727d6c565d8aa3-chunk-022</data>
  <data key="d4">Hybrid Memetic Algorithm to Solve Multiobjective Distributed Fuzzy Flexible Job Shop Scheduling Problem with Transfer-71a8369b.pdf&lt;SEP&gt;A memetic algorithm for the flexible job shop scheduling problem with job priority-f303156f.pdf</data>
  <data key="d5">1785848303</data>
  <data key="d6"></data>
</node>
<node id="Swarm-based neighbourhood search algorithm for fuzzy flexible job shop scheduling">
  <data key="d0">Swarm-based neighbourhood search algorithm for fuzzy flexible job shop scheduling</data>
