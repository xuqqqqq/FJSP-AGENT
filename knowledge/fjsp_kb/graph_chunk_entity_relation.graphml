  <data key="d1">method</data>
  <data key="d2">一种将多目标优化问题分解为多个单目标子问题的多目标优化技术。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-007</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
  <data key="d5">1785830239</data>
