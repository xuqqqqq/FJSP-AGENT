</node>
<node id="Local Intensification Search">
  <data key="d0">Local Intensification Search</data>
  <data key="d1">method</data>
  <data key="d2">针对低密度区域的局部强化搜索，以提升算法的开采能力。</data>
  <data key="d3">doc-3064a959dca3e0581ecf9bc89a1a99fd-chunk-000</data>
  <data key="d4">A_Feedback_Learning-Based_Memetic_Algorithm_for_Energy-Aware_Distributed_Flexible_Job-Shop_Scheduling_With_Transportation_Constraints-32f047d1.pdf</data>
