  <data key="d13"></data>
</edge>
<edge source="Regular Production Operation" target="MNew_NON Procedure">
  <data key="d7">1.0</data>
  <data key="d8">当操作是常规生产操作时，MNew_NON过程直接跳转到步骤3进行常规分配。</data>
  <data key="d9">处理,操作类型</data>
  <data key="d10">doc-0366a0700c144941e3596414c0dfb191-chunk-005</data>
