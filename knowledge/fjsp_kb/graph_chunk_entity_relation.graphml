  <data key="d0">OS层染色体</data>
  <data key="d1">data</data>
  <data key="d2">表示操作序列的染色体片段，是三层编码方案的一部分。</data>
  <data key="d3">doc-49755fa14becf5cd2da17cfb1053b33b-chunk-012</data>
  <data key="d4">A multi-critical-path co-driven evolutionary algorithm addressing the dual-resource flexible job shop scheduling problem with offline operations and j-8f6b0523.pdf</data>
  <data key="d5">1785854094</data>
  <data key="d6"></data>
</node>
<node id="MS层染色体">
  <data key="d0">MS层染色体</data>
  <data key="d1">data</data>
  <data key="d2">表示机器选择的染色体片段，记录每个操作分配的机器。</data>
  <data key="d3">doc-49755fa14becf5cd2da17cfb1053b33b-chunk-012</data>
  <data key="d4">A multi-critical-path co-driven evolutionary algorithm addressing the dual-resource flexible job shop scheduling problem with offline operations and j-8f6b0523.pdf</data>
  <data key="d5">1785854094</data>
  <data key="d6"></data>
</node>
<node id="WS层染色体">
  <data key="d0">WS层染色体</data>
  <data key="d1">data</data>
  <data key="d2">表示工人分配的染色体片段，记录每个操作分配的工人。</data>
  <data key="d3">doc-49755fa14becf5cd2da17cfb1053b33b-chunk-012</data>
  <data key="d4">A multi-critical-path co-driven evolutionary algorithm addressing the dual-resource flexible job shop scheduling problem with offline operations and j-8f6b0523.pdf</data>
