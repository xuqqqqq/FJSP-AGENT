  <data key="d6"></data>
</node>
<node id="Taguchi实验设计方法">
  <data key="d0">Taguchi实验设计方法</data>
  <data key="d1">method</data>
  <data key="d2">田口方法，一种实验设计技术，用于确定EMA的关键参数组合。</data>
  <data key="d3">doc-e5d47f23ff2115fdf069ba128946a7e2-chunk-001</data>
  <data key="d4">An efficient memetic algorithm for distributed flexible job shop scheduling problem with transfers-316215e1.pdf</data>
