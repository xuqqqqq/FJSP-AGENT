{
  "schema_version": 1,
  "family_id": "standard_fjsp",
  "aliases": [
    "FJSP",
    "fjsp"
  ],
  "capability": {
    "display_name": "标准柔性作业车间调度",
    "description": "标准 FJSP 实例，包含工序优先约束、每道工序可选替代机器、机器容量不可重叠约束，并以总工期（makespan）作为默认目标。",
    "supported_variants": [
      "standard_fjsp",
      "fjsp_with_best_known_gap",
      "fjsp_sdst",
      "fjsp_min_time_lag"
    ],
    "canonical_objectives": [
      {
        "name": "makespan",
        "direction": "minimize",
        "priority": 1
      },
      {
        "name": "gap_pct",
        "direction": "minimize",
        "priority": 2,
        "optional": true
      },
      {
        "name": "runtime_seconds",
        "direction": "minimize",
        "priority": 3,
        "optional": true
      }
    ],
    "io_contract_notes": [
      "实例使用通用文本格式：job_count machine_count max_candidate_count，后续紧跟各作业定义。",
      "解必须使用 standard_fjsp_schedule_v1 JSON，并为每道工序提供一条记录。",
      "所有合法性检查均由 Evaluator 负责：优先约束、机器可加工性、加工时长和机器重叠。",
      "Min Time-Lag FJSP 在标准主体后使用 K + K×4 相邻工序约束列表，并要求 successor_start - predecessor_end >= L_min。"
    ],
    "evaluator_invariants": [
      "在演进求解器代码时，不要修改 examples/standard_fjsp_evaluator.py。",
      "在没有新的且经用户确认的 IO contract 前，不要修改 harness_agent/domains/io.py 中的解析器或校验器。",
      "候选求解器可以自行检查，但是否晋升仅取决于 Core evaluator 输出。"
    ],
    "solver_entrypoints": [
      "examples/agent_generated_fjsp_solver.py"
    ],
    "specialization_hooks": [
      "requirement_feature_extraction",
      "method_package_retrieval",
      "agent_generated_solver",
      "best_known_gap_feedback"
    ],
    "knowledge_tags": [
      "fjsp",
      "dispatch_rules",
      "critical_path",
      "critical_block_neighborhood",
      "machine_reassignment",
      "tabu_search",
      "awls"
    ]
  },
