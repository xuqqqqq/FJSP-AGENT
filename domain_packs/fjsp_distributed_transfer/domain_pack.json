    "knowledge_query": {
      "default_limit": 6,
      "tag_descriptions": {
        "construction": "从零建立稳定合法 baseline 的构造规则与状态闭环。",
        "constructive_search": "在构造过程中用有界多状态搜索联合决定 ready operation、工厂、机器和顺序。",
        "beam_search": "用状态下界、结构去重和宽度上限保留多个部分排程。",
        "idle_gap": "在每个工厂-机器已有区间中寻找最早可行空隙。",
        "critical_dispatch": "结合剩余工作量、转移等待、工厂负载和机器空闲压力选择下一道 ready operation。",
        "initialization": "多起点、负载感知、工厂分配感知和可复现初解。",
        "decoder": "factory assignment、machine assignment 加机器序列的完整可行解码，并传播同工件转移时间。",
        "multi_start": "通过工厂分配、机器分配和工序顺序结构指纹保持多个不同入口。",
        "load_balance": "诊断和改善最大工厂负载、机器负载集中与跨厂转移等待。",
        "critical_path": "从当前解提取关键路径、紧弧和由转移等待造成的关键延迟。",
        "critical_block": "围绕关键工厂-机器块生成顺序邻域，并通过分布式转移时间重解码。",
