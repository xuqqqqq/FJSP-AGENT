    "knowledge_query": {
      "default_limit": 6,
      "tag_descriptions": {
        "construction": "从零建立稳定合法 baseline 的构造规则与状态闭环。",
        "constructive_search": "在构造过程中用有界多状态搜索联合决定 ready operation、机器、顺序和可用时间片。",
        "beam_search": "用状态下界、结构去重和宽度上限保留多个部分排程。",
        "idle_gap": "在机器已有加工区间和不可用窗口之间寻找最早可行空隙，而非只向时间轴尾部追加。",
        "critical_dispatch": "结合剩余工作量、机器空闲压力和可用窗口碎片选择下一道 ready operation。",
        "initialization": "多起点、负载感知、机器日历感知和可复现初解。",
        "decoder": "assignment 加机器序列的完整可行解码，并在 NFA 中跳过机器不可用区间。",
        "multi_start": "通过结构指纹保持多个不同入口。",
        "load_balance": "诊断和改善机器负载集中，同时考虑维修窗口造成的有效产能下降。",
        "critical_path": "从当前解提取关键路径、紧弧和受维修窗口阻塞的关键机器片段。",
        "critical_block": "围绕关键机器块生成顺序邻域，并通过机器日历重解码。",
        "local_search": "有界局部改进与接受控制。",
        "tabu_search": "禁忌属性、逆移动、特赦和全局 best。",
        "ils": "局部搜索、扰动和重启的迭代闭环。",
        "machine_reassignment": "柔性工序换机并重新插入机器序列。",
        "assignment_search": "机器分配空间的负载、加工时间和有效可用窗口权衡。",
        "assignment_aware_local_search": "联合换机、插入和关键块排序，并保持 calendar-aware timing。",
        "adaptive_weight": "基于搜索历史和维修窗口阻塞情况改变可达 move 评分。",
        "cp_sat": "完整 CP-SAT 模型或局部精确修复。",
        "exact_method": "精确建模、界和求解状态处理。",
        "trust_region": "只释放少量关键分配、顺序或时间变量。",
        "population": "保持多个 assignment/order 盆地的群体搜索。",
        "genetic": "FJSP 双层编码、交叉和变异。",
        "memetic": "群体探索与受控局部改进结合。",
        "diversity": "结构去重、距离和停滞重启。",
        "hybrid": "构造、局部搜索、群体或精确方法的职责清晰组合。",
        "machine_availability": "机器存在预先给定的不可用维修区间，调度时工序不能跨越或落入不可用窗口。",
        "machine_calendar": "将机器可用和不可用时间窗口作为解码、插入和局部移动评估的机器日历。",
        "maintenance": "设备维修、预防维护或不可用区间对 FJSP 调度目标和可行性的影响。",
        "maintenance_window": "半开维修窗口 [start, end) 的建模、合并、跳过和冲突检测。",
        "availability_aware_insertion": "在机器可用空隙中寻找最早可行插入位置，并避免跨越不可用区间。",
        "calendar_aware_decoder": "解码器在计算最早开工时间时跳过机器不可用区间，并保持工序覆盖、候选机器和 precedence 合法。",
        "availability_repair": "对违反机器可用性约束的候选排程进行推迟、换机或重插入修复。",
        "calendar_aware_move_delta": "局部搜索 move 的增量评估必须重算受影响机器序列中的维修窗口等待和下游传播。"
      },
