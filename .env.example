# Optional host port for Docker Compose.
FJSP_WEB_PORT=7860

# Self-hosted Qiming OpenAI-compatible gateway. One key exposes both models;
# choose them as qiming/glm-5.2 or qiming/deepseek-v4-flash in the Web UI.
# QIMING_API_KEY=
# QIMING_API_KEY_FILE=/run/secrets/qiming_api_key
QIMING_BASE_URL=https://cpa.qiming.zone/v1

# A key is not required to start the Web UI, but it is required to run an
# OpenCode-backed solver evolution job.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# For an OpenAI-compatible gateway that intentionally uses the DEEPSEEK_* key
# and base URL above, enable this explicit adapter instead of duplicating the
# secret. Do not enable it for the official DeepSeek endpoint.
# OPENCODE_OPENAI_COMPAT_FROM_DEEPSEEK=true

# OpenCode uses these models for Main and Coding Worker. The legacy
# OPENCODE_MODEL value remains the fallback for both.
OPENCODE_MODEL=deepseek/deepseek-v4-pro
# OPENCODE_MAIN_MODEL=deepseek/deepseek-v4-pro
# OPENCODE_WORKER_MODEL=deepseek/deepseek-v4-pro

# To default both Agent roles to the self-hosted DeepSeek model:
# OPENCODE_MODEL=qiming/deepseek-v4-flash
# OPENCODE_MAIN_MODEL=qiming/deepseek-v4-flash
# OPENCODE_WORKER_MODEL=qiming/deepseek-v4-flash
