# Copy this file to `.env` for local runs. `.env` is ignored by git.
#
# Prefer DEEPSEEK_API_KEY_FILE when the key is stored in a private file outside
# the repository. Use DEEPSEEK_API_KEY only for short-lived local experiments.
#
# DEEPSEEK_API_KEY=replace-with-local-key
# DEEPSEEK_API_KEY_FILE=C:\Users\you\.secrets\deepseek_api_key.txt
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com
